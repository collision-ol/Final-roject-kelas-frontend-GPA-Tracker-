{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "web",
  "account_id": "eadd509a2a6ceaad17af1b7c248139f0",
  "main": "./dist/server/cf-worker.js",
  "compatibility_date": "2026-11-17",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gradpath",
      "database_id": "7cdce749-602d-4ad1-8aa1-8dfe87c44591",
      "migrations_dir": "drizzle"
    }
  ],
  "observability": {
    "enabled": true
  }
}
